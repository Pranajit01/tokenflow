{
  "name": "tokenflow",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "test": "node --test __tests__/*.test.js server/__tests__/*.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
